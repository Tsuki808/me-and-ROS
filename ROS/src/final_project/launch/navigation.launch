<launch>
  <arg name="slam" default="false"/>
  <arg name="slam_scan_topic" default="/scan"/>
  <arg name="map_file" default="$(find final_project)/maps/delivery.yaml"/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="-1.2"/>
  <arg name="initial_yaw" default="1.57079632679"/>
  <arg name="simple_goal_topic" default="/move_base_simple/goal"/>
  <group unless="$(arg slam)">
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)"/>
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="global_frame_id" value="map"/>
    <param name="initial_pose_x" value="$(arg initial_x)"/>
    <param name="initial_pose_y" value="$(arg initial_y)"/>
    <param name="initial_pose_a" value="$(arg initial_yaw)"/>
    <param name="initial_cov_xx" value="0.01"/>
    <param name="initial_cov_yy" value="0.01"/>
    <param name="initial_cov_aa" value="0.01"/>
    <param name="odom_model_type" value="diff-corrected"/>
    <!-- Gazebo world odometry is precise; defaults model much noisier wheel odometry. -->
    <param name="odom_alpha1" value="0.001"/>
    <param name="odom_alpha2" value="0.001"/>
    <param name="odom_alpha3" value="0.001"/>
    <param name="odom_alpha4" value="0.001"/>
    <param name="min_particles" value="500"/>
    <param name="max_particles" value="2000"/>
    <param name="resample_interval" value="1"/>
    <param name="update_min_d" value="0.05"/>
    <param name="update_min_a" value="0.05"/>
    <param name="laser_max_beams" value="90"/>
    <param name="laser_model_type" value="likelihood_field_prob"/>
    <param name="laser_sigma_hit" value="0.05"/>
    <param name="transform_tolerance" value="0.5"/>
  </node>
  </group>
  <node if="$(arg slam)" pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <rosparam file="$(find final_project)/config/slam.yaml"/>
    <remap from="scan" to="$(arg slam_scan_topic)"/>
  </node>
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find final_project)/config/navigation.yaml"/>
    <!-- Only mode 2 consumes the changing SLAM map and uses general navigation tolerances. -->
    <rosparam if="$(arg slam)" file="$(find final_project)/config/slam_navigation.yaml"/>
    <remap from="cmd_vel" to="/final_project/navigation_cmd_vel"/>
    <remap from="/move_base_simple/goal" to="$(arg simple_goal_topic)"/>
  </node>
</launch>
