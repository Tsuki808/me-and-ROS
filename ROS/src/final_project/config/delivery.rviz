Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/LaserScan
      Name: Laser
      Enabled: true
      Topic: /scan
      Size (m): 0.02
    - Class: rviz/Odometry
      Name: Odometry
      Enabled: true
      Topic: /odom
      Keep: 100
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape: Arrow
      Covariance:
        Value: false
    - Class: rviz/Path
      Name: Navigation path
      Enabled: true
      Topic: /move_base/NavfnROS/plan
    - Class: rviz/Map
      Name: Local obstacles
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Alpha: 0.35
      Color Scheme: costmap
    - Class: rviz/Pose
      Name: Navigation goal
      Enabled: true
      Topic: /move_base/current_goal
    - Class: rviz/Image
      Name: Inspection camera
      Enabled: true
      Image Topic: /inspection/image_raw
      Queue Size: 2
    - Class: rviz/Image
      Name: Kinect RGB
      Enabled: true
      Image Topic: /kinect/rgb/image_raw
      Queue Size: 2
    - Class: rviz/Image
      Name: Kinect Depth
      Enabled: true
      Image Topic: /kinect/depth/image_raw
      Normalize Range: true
      Queue Size: 2
    - Class: rviz/PointCloud2
      Name: Kinect PointCloud
      Enabled: true
      Topic: /kinect/depth/points
      Queue Size: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.015
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: RGB8
    - Class: rviz/Marker
      Name: Visual marker
      Enabled: true
      Marker Topic: /visualization_marker
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.8
      Yaw: 4.7
Window Geometry:
  Width: 1100
  Height: 750
