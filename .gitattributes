# 统一换行：仓库以 LF 存储，避免 Windows 检出时把脚本改成 CRLF
* text=auto eol=lf

# 二进制文件不做换行转换与文本 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp4  binary
*.onnx binary
*.pgm  binary
*.pdf  binary
*.bag  binary

# 显式声明脚本换行
*.py     text eol=lf
*.sh     text eol=lf
*.launch text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
